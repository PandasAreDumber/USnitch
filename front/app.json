{
  "expo": {
    "name": "USnitch",
    "slug": "usnitch",
    "scheme": "usnitch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "Choose a photo to share a parking enforcement sighting.",
        "cameraPermission": "Take a photo to share a parking enforcement sighting.",
        "microphonePermission": false
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "Show your location on the campus map and help place parking enforcement sightings."
      }]
    ]
  }
}
